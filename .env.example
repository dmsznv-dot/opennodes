# LocalFlow v1 — Production Environment Configuration
NODE_ENV=production
LOG_LEVEL=info

# Ports
API_PORT=4000
WEB_PORT=3000

# PostgreSQL (Primary Relational Store & Execution Journal)
POSTGRES_USER=localflow
POSTGRES_PASSWORD=localflow
POSTGRES_DB=localflow
DATABASE_URL=postgres://localflow:localflow@postgres:5432/localflow
# The API applies schema migrations on startup. Without Docker, the API alone can run on
# embedded Postgres: DATABASE_URL=pglite://./.data/api  (persisted)  or  pglite://memory

# Redis (BullMQ Job Queue, Delayed Steps & Distributed Locks)
REDIS_URL=redis://redis:6379

# Security & Cryptography
# Master key for AES-256-GCM envelope encryption of workspace credentials (64 hex chars = 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Session signing secret (minimum 32 characters)
SESSION_SECRET=change-me-in-production-min-32-chars-secret-key

# Sandboxed Filesystem Root (Core Filesystem Connector)
ALLOWED_FS_ROOT=/data/allowed

# Worker Daemon Configuration
WORKER_CONCURRENCY=10
