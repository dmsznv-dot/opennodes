{
  "name": "@localflow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@localflow/db": "workspace:*",
    "@localflow/observability": "workspace:*",
    "@localflow/shared": "workspace:*",
    "@localflow/workflow-engine": "workspace:*",
    "@localflow/workflow-schema": "workspace:*",
    "bullmq": "^5.41.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
