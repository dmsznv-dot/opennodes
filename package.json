{
  "name": "opennodes",
  "version": "0.1.0",
  "private": true,
  "description": "OpenNodes — Independent, deterministic visual workflow automation platform and DAG execution engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmsznv-dot/opennodes.git"
  },
  "homepage": "https://dmsznv-dot.github.io/opennodes/",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "start:local": "node scripts/start-local.mjs",
    "build:macos": "node scripts/build-macos.mjs",
    "backup": "node scripts/backup.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
